# ── Content Agent OS ───────────────────────────────────────────────
# Copy to .env and fill in. Never commit your real .env.

# Dashboard port (default 3950). Sibling ports — job-scraper 3847,
# google-search 3848, download 3939, hr-finding 3940, maps 3942
PORT=3950

# Max scrape sources fetched in parallel
SCRAPE_CONCURRENCY=5

# ── Scraping ───────────────────────────────────────────────────────
# Firecrawl — scrape any URL / search the web. https://firecrawl.dev
FIRECRAWL_API_KEY=

# ── AI (Google Gemini, OpenRouter, or Groq) ──────────────────────────
# Option A (Recommended): Google Gemini API key (from Google AI Studio: https://aistudio.google.com/app/apikey)
# Fast, multimodal (vision + screen capture), native function calling, 1M+ context.
GEMINI_API_KEY=

# Google Cloud Text-to-Speech (4 Million chars/month free tier)
# https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
# Can use the same key as GEMINI_API_KEY or dedicated GOOGLE_TTS_API_KEY
GOOGLE_TTS_API_KEY=

GOOGLE_TTS_VOICE=en-US-Journey-F

# Option B: OpenRouter key for GPT, Claude, Gemini, etc. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: appears on OpenRouter leaderboards
OPENROUTER_SITE_URL=http://localhost:3950
OPENROUTER_SITE_NAME=Content Agent OS

# Option C: Groq Free API key for high-speed Llama & Whisper. https://console.groq.com/keys
GROQ_API_KEY=

# ── Social Direct Publishing (100% Free - Official Developer APIs) ─
# LinkedIn Direct: Create an app at https://www.linkedin.com/developers/apps
# Request "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect".
# Add Authorized Redirect URI: http://localhost:3950/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3950/api/auth/linkedin/callback

# GitHub OAuth App: Create at https://github.com/settings/developers
# Authorized callback URL: http://localhost:3950/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3950/api/auth/github/callback

# Public base URL of this app (for OAuth callback).
PUBLIC_BASE_URL=http://localhost:3950

# ── Google / Gmail (HUD dashboard: mail + expense scraping) ────────
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
#   1. Create a project → enable the "Gmail API".
#   2. Configure the OAuth consent screen (External), add your Google account
#      as a Test user, and add scope .../auth/gmail.readonly
#   3. Create an "OAuth client ID" of type "Web application".
#   4. Add this exact Authorized redirect URI:
#        http://localhost:3950/api/gmail/callback
#      (must match GOOGLE_REDIRECT_URI / PUBLIC_BASE_URL below)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — defaults to ${PUBLIC_BASE_URL}/api/gmail/callback
GOOGLE_REDIRECT_URI=http://localhost:3950/api/gmail/callback

# ── Defaults (all overridable in the dashboard Settings tab) ───────
DEFAULT_FRESHNESS_HOURS=24
OPENROUTER_TEXT_MODEL=anthropic/claude-sonnet-4
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
DEFAULT_TIMEZONE=Asia/Karachi

# ── News API (Live breaking news & topics search) ─────────────────
# Get free API key from https://newsapi.org
NEWS_API_KEY=

# ── Weather API (Optional: OpenWeatherMap or WeatherAPI) ───────────
# Get free API key from https://openweathermap.org or https://weatherapi.com
# (Note: Weather also works automatically with zero-key fallback)
OPENWEATHER_API_KEY=
WEATHER_API_KEY=

# ── Telegram Bot (100% Free, zero app review) ─────────────────────
# Create a bot via @BotFather on Telegram → /newbot → get token
# Then create a channel, add the bot as admin, and use @channel_name or -100xxxxx
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ── Discord Webhook (100% Free, instant setup) ────────────────────
# Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=

# ── Twitter/X (Free Tier: 1,500 tweets/month) ─────────────────────
# Create app at developer.x.com → Free tier → generate keys
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ── Instagram (Free via Meta Graph API) ────────────────────────────
# Requires Instagram Creator/Business account linked to a Facebook Page
# Use Meta Developer Portal → Create App → Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ── Local LLM Fallback (Ollama / LM Studio) ───────────────────────
# Activates automatic offline fallback if OpenRouter/Groq is unreachable
# Install Ollama: https://ollama.com → ollama pull llama3.3
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.3

# ── Projects Directory (Cooper's dev tools) ───────────────────────
# Cooper can list repos, check git status, and open projects in VS Code
PROJECTS_DIR=

# ── Browser Agent (Autonomous Chrome Automation via browser-use) ────
# Cooper automatically uses GEMINI_API_KEY, OPENROUTER_API_KEY, or OPENAI_API_KEY.
# Optional dedicated Browser Use Cloud API key (if using hosted cloud browsers):
# BROWSER_USE_API_KEY=

# ── AgentMemory (Persistent Long-Term Memory & Knowledge Graph) ───────
# AgentMemory daemon provides REST API on :3111 and Live Graph Viewer on :3113.
# Cooper uses hybrid BM25 + Knowledge Graph + Local SQLite fallback.
AGENTMEMORY_URL=http://localhost:3111
AGENTMEMORY_VIEWER_URL=http://localhost:3113
# Secret is read automatically from ~/.agentmemory/secret or set explicitly:
# AGENTMEMORY_SECRET=

# ── OpenViking (Context Database & Virtual Filesystem viking://) ─────
# Hierarchical L0/L1/L2 progressive context disclosure & repo indexing.
OPENVIKING_URL=http://127.0.0.1:1933
# OPENVIKING_API_KEY=
# OPENVIKING_ACCOUNT=cooper
# OPENVIKING_USER=master

# ── VoiceStudio OmniVoice (Local Speech Synthesis & STT Engine) ─────
# Local, private, zero-latency JARVIS butler voice cloning on :3900.
# Automatically falls back to Google Cloud TTS and Groq Whisper if offline.
VOICESTUDIO_URL=http://127.0.0.1:3900
VOICESTUDIO_VOICE=jarvis-prime


